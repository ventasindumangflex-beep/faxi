# Copia este archivo como .env dentro de CADA app (apps/passenger/.env, apps/driver/.env, apps/admin/.env.local)
# y rellena solo las variables que use esa app. NUNCA pongas la service_role key aquí.

# ── Apps móviles (passenger y driver) ──
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_PLACES_KEY=          # solo passenger · clave restringida a "Places API (New)"
EXPO_PUBLIC_TERMS_URL=https://faxi.do/terminos
EXPO_PUBLIC_PRIVACY_URL=https://faxi.do/privacidad
EXPO_PUBLIC_SUPPORT_WHATSAPP=18095550000
GOOGLE_MAPS_ANDROID_KEY=                # clave "Maps SDK for Android" restringida al paquete + SHA-1
EAS_PROJECT_ID=                         # lo crea `eas init`
EXPO_PUBLIC_SENTRY_DSN=                 # Sentry → proyecto React Native → Client Keys (DSN). Vacío = sin Sentry
SENTRY_ORG=                             # opcional, para subir mapas de código en EAS
SENTRY_PROJECT=                         # opcional
# SENTRY_AUTH_TOKEN va como secreto de EAS (eas env:create), nunca aquí

# ── Admin (Next.js) ──
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
