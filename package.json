{
  "name": "faxi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "passenger": "npm --workspace apps/passenger run start",
    "driver": "npm --workspace apps/driver run start",
    "admin": "npm --workspace apps/admin run dev",
    "db:test": "for f in supabase/tests/*.sql; do psql \"$DB_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "expo-router": "~6.0.0"
  }
}
